# ==========================================================================
# نمونهٔ متغیرهای محیطی — این فایل *کامیت می‌شود*
# --------------------------------------------------------------------------
# هیچ مقدار واقعی اینجا ننویسید. روی همروش مقدارها را مستقیم در پنل
# بگذارید؛ برای لوکال:  cp .env.example .env  و بعد پر کنید.
# ==========================================================================

# ---------- حالت اجرا ----------
DEBUG="True"

# ---------- کلید امضای جنگو (الزامی وقتی DEBUG=False) ----------
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=""
ALLOWED_HOSTS=""
CSRF_TRUSTED_ORIGINS=""

# ---------- دیتابیس (اختیاری) ----------
# خالی = SQLite در /data/zoul. با DB_HOST به Postgres وصل می‌شود.
DB_NAME=""
DB_USER=""
DB_PASS=""
DB_HOST=""
DB_PORT="5432"

# ---------- مدل ----------
DEEPSEEK_API_KEY=""
# خالی = پیش‌فرض OpenMuse
OPENMUSE_LLM_MODEL=""

# ---------- موتور OpenMuse ----------
# توکن دسترسی به API و وب‌اپ موتور. خالی = موتور خودش یکی می‌سازد و در
# /data/openmuse/server_token نگه می‌دارد. همین مقدار را جنگو هم می‌خواند.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
OPENMUSE_SERVER_TOKEN=""
# 1 = موتور داخل همین کانتینر کنار وب اجرا شود (پیش‌فرض، همروش و لوکال).
RUN_ENGINE="1"
GUNICORN_WORKERS="1"
